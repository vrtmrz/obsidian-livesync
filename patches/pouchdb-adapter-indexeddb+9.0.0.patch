diff --git a/node_modules/pouchdb-adapter-indexeddb/lib/index.es.js b/node_modules/pouchdb-adapter-indexeddb/lib/index.es.js
index fb127a2..ea1ad12 100644
--- a/node_modules/pouchdb-adapter-indexeddb/lib/index.es.js
+++ b/node_modules/pouchdb-adapter-indexeddb/lib/index.es.js
@@ -128,6 +128,34 @@ function idbError(callback) {
   };
 }
 
+// iOS (WebKit) aborts transactions that are in progress when the app is suspended.
+// Several operations only listen for request success or transaction completion, so
+// an aborted transaction left their callback pending forever. Settle the callback
+// with an IDB_ERROR when the transaction aborts; whichever outcome comes first wins.
+function settleOnAbort(txn, callback) {
+  let settled = false;
+  function settle(err, res) {
+    if (settled) {
+      return;
+    }
+    settled = true;
+    callback(err, res);
+  }
+  txn.addEventListener('abort', idbError(settle));
+  return settle;
+}
+
+// The operation's callback is its last argument; a one-shot changes() call reports
+// through opts.complete instead.
+function settleArgsOnAbort(txn, args) {
+  const last = args.length - 1;
+  if (typeof args[last] === 'function') {
+    args[last] = settleOnAbort(txn, args[last]);
+  } else if (args[0] && typeof args[0].complete === 'function' && !args[0].continuous) {
+    args[0].complete = settleOnAbort(txn, args[0].complete);
+  }
+}
+
 function processAttachment(name, src, doc, isBinary, attachmentFormat) {
 
   delete doc._attachments[name].stub;
@@ -1841,6 +1869,9 @@ function IndexeddbPouch(dbOpts, callback) {
         console.error(err);
         txn.error = err;
       }).then(function () {
+        if (txn.txn) {
+          settleArgsOnAbort(txn.txn, args);
+        }
         args.unshift(txn);
         fun.apply(api, args);
       });
